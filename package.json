{
  "name": "lecture-lyft",
  "version": "2.0.0",
  "private": true,
  "description": "Lecture Lyft desktop shell",
  "author": "Lecture Lyft",
  "main": "dist-electron/main.js",
  "workspaces": [
    "webapp"
  ],
  "scripts": {
    "clean": "rimraf dist-electron release resources/backend-dist .cache/pyinstaller",
    "dev": "concurrently -k -n RENDERER,ELECTRON,APP -c cyan,yellow,green \"npm run dev:renderer\" \"npm run dev:electron\" \"npm run dev:app\"",
    "dev:renderer": "npm run dev --workspace webapp -- --host 127.0.0.1 --port 3000",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:app": "wait-on tcp:3000 file:dist-electron/main.js && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://127.0.0.1:3000 LECTURE_LYFT_BACKEND_URL=http://127.0.0.1:8000 LECTURE_LYFT_WS_URL=ws://127.0.0.1:8000/ws electron .",
    "generate:icons": "node ./resources/scripts/generate-icons.mjs",
    "build:renderer": "npm run build --workspace webapp",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:backend": "node ./resources/scripts/build-backend.mjs",
    "build": "npm run clean && npm run generate:icons && npm run build:renderer && npm run build:electron && npm run build:backend",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "rimraf": "^6.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  }
}
